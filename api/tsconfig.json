{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",

    /* Strict mode is intentional: it forces us to handle null/undefined
       and mismatched types at compile time instead of discovering them
       in production. This matters more here than in a throwaway script
       because job state, pricing, and permissions all depend on data
       being the shape we think it is. */
    "strict": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
