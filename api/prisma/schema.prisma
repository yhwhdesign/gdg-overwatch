// schema.prisma
//
// This file defines Overwatch's database structure. Prisma reads this
// file and generates a type-safe client (`@prisma/client`) so that
// database queries in our TypeScript code are checked at compile time —
// e.g. if you typo a field name, you get an error before running the
// code, not a silent bug in production.
//
// This is intentionally minimal right now (Phase 0/1 foundation only).
// Real business tables (jobs, customers, parts, pricing...) get added
// starting in Phase 2+ as each vertical slice needs them — we do not
// build the entire database up front (see PROJECT_STATE.md Section 8,
// "vertical slices").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Organization represents one company using Overwatch.
//
// WHY THIS EXISTS ALREADY, THIS EARLY:
// PROJECT_STATE.md's Phase 0 architecture decisions establish Overwatch
// as multi-tenant-READY from day one, even though only one organization
// (the project owner's company) will exist for the foreseeable future.
// Every future table that holds company-specific data (jobs, customers,
// users, parts, pricing, etc.) will include an organizationId foreign
// key pointing here, and every query will be scoped by it. Retrofitting
// that scoping after tables already exist without it is a much larger,
// riskier migration than including it from the start.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  // Future relations will attach here, e.g.:
  // jobs      Job[]
}

// User represents one person who can log into Overwatch (initially:
// technicians and office staff at the owner's company).
//
// WHY organizationId IS HERE:
// Consistent with the multi-tenant-ready decision above — every user
// belongs to exactly one organization, and every query for "give me
// this org's users" filters by it, even though only one organization
// exists today.
//
// WHY "capabilities" INSTEAD OF A SINGLE "role":
// A rigid role like technician/admin gets painful fast — the first time
// you need "office staff who can view pricing but not edit it," a
// single role field can't express that. Capabilities are a flat list of
// specific permissions (e.g. "jobs:view_own", "jobs:edit_status",
// "pricing:view") checked by name in middleware. This is the
// capability-based permission model called for in PROJECT_STATE.md.
// It's a plain string array (no separate table) deliberately — simple
// enough to read and reason about at this stage; if the permission
// model grows much more complex later (e.g. per-organization custom
// roles), it can be promoted to its own table without changing how
// callers check permissions.
model User {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  email        String @unique
  passwordHash String
  name         String

  // e.g. ["jobs:view_own", "jobs:edit_status"]. See comment above.
  capabilities String[]

  // Deactivating someone sets this to false rather than deleting the
  // row — this preserves their history (who did what job, when) while
  // immediately blocking login. Session lookups also check this flag,
  // so an active session is invalidated the moment this flips to false.
  isActive Boolean @default(true)

  // True for a user created by an admin with a temporary password (see
  // routes/users.ts). While true, the login flow forces them to set a
  // real password before they can do anything else — this is how we
  // avoid needing an email-invite system (Section 35D's zero-cost
  // policy): an admin can create a working account and hand over a
  // temporary password directly, without any email infrastructure.
  mustChangePassword Boolean @default(false)

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Session represents one logged-in browser/device for one user.
//
// WHY A DATABASE TABLE INSTEAD OF A JWT:
// This is the Phase 2 architecture decision logged in PROJECT_STATE.md —
// server-side sessions were chosen over JWTs specifically because they
// can be revoked instantly (delete the row = that device is logged out
// immediately), which matters for a workforce app where someone's
// access may need to be cut off the moment they're let go. A JWT can't
// be un-issued before it naturally expires.
model Session {
  // The token itself is the primary key — it's a long, random,
  // unguessable string (generated in code, not by the database) that
  // gets stored in the user's browser as an httpOnly cookie. Looking up
  // a session is just "does a row with this token exist and is it not
  // expired."
  token String @id

  userId String
  user   User   @relation(fields: [userId], references: [id])

  expiresAt DateTime
  createdAt DateTime @default(now())
}