# Copy this file to `.env` in the api/ folder and fill in real values.
# .env is gitignored on purpose — real credentials must never be committed
# (Section 5/11 of PROJECT_STATE.md: secrets must be protected).

# Get this from your Neon project dashboard (Connection Details).
# Use the "pooled" connection string for the app; Prisma migrations
# should use the direct (non-pooled) connection — Neon's dashboard
# labels both clearly.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Local dev server port for the API (Vite frontend uses a different
# port by default, so these don't collide).
PORT=3001
